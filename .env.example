# Supabase — see https://supabase.com/dashboard/project/_/settings/api
# URL + anon key are PUBLIC; service role key is server-only and must never
# be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL_HERE
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Service role key — server-only. Required for admin writes (creating /
# cancelling room_bookings rows). Keep it out of any file imported by
# client components.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# Single-admin allowlist for the /admin route tree. The login callback
# signs out any user whose email doesn't match (case-insensitive).
ADMIN_EMAIL=owner@example.com

# Google Analytics 4 measurement ID. Optional — when unset, the site emits
# no analytics (handy for dev/preview). Create a property at
# analytics.google.com → Admin → Data Streams → Web. Format: "G-XXXXXXXXXX".
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Payment provider for the public booking flow. "demo" is a self-contained
# simulated checkout used for end-to-end flow testing (no real money). Flip
# to "razorpay" when the Razorpay keys below are populated.
PAYMENT_PROVIDER=demo

# Razorpay credentials. Not wired yet — the createPaymentOrder /
# confirmPayment server actions throw when PAYMENT_PROVIDER=razorpay
# until the Razorpay implementation lands. Keep these in env so the
# infra is ready when the client provides the values.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Base URL of the deployed site. Used inside the admin WhatsApp
# notification to build a clickable link back to the booking. Optional —
# the message is sent without the link if this is unset.
NEXT_PUBLIC_BASE_URL=https://shehnairesort.in

# WhatsApp admin notifications — fires when a public booking is paid for.
# Provider options:
#   log        — Default. Console-logs the message; no real delivery.
#                Useful for dev / before you wire a real provider.
#   callmebot  — Free third-party for personal WhatsApp numbers.
#                Setup: from the admin's WhatsApp, send the message
#                "I allow callmebot to send me messages" to +34 644 51 95 23,
#                wait for the reply with the API key, paste below.
#   cloudapi   — Meta WhatsApp Cloud API. Free tier (~1000 convos/month).
#                Requires Meta Business verification + permanent token +
#                phone number id. Production-grade; ~2-3 days to set up.
WHATSAPP_PROVIDER=log

# callmebot only
CALLMEBOT_API_KEY=

# cloudapi only — get these from Meta Developer Console once verified.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
