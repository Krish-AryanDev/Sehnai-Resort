# Supabase — see https://supabase.com/dashboard/project/_/settings/api
# URL + anon key are PUBLIC; service role key is server-only and must never
# be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL_HERE
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Service role key — server-only. Required for admin writes (creating /
# cancelling room_bookings rows). Keep it out of any file imported by
# client components.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# Single-admin allowlist for the /admin route tree. The login callback
# signs out any user whose email doesn't match (case-insensitive).
ADMIN_EMAIL=owner@example.com

# Google Analytics 4 measurement ID. Optional — when unset, the site emits
# no analytics (handy for dev/preview). Create a property at
# analytics.google.com → Admin → Data Streams → Web. Format: "G-XXXXXXXXXX".
NEXT_PUBLIC_GA_MEASUREMENT_ID=
